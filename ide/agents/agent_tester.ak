## AK CODE Tester Agent — generates and runs unit tests for AK CODE
## Analyzes source code, identifies edge cases, and produces test suites

make kind called AgentTester extends AgentBase

    when created
        ## Initialize as "Tester" agent for automated test generation
        name = "Tester"
        description = "Generates unit tests for AK CODE source files"
        status = "idle"
        conversation = list of
        model = "default"
        temperature = 0.4
    end

    behaviour process taking task and context
        ## Analyze the provided code and generate a complete test suite
        set status "working"
        add message "user" to task

        let test_suite = generate tests for taking task and "all"

        set status "done"
        give back test_suite
    end

    behaviour generate tests for taking code and function_name
        ## Produce a test suite in AK CODE for the given function or all functions
        set status "thinking"
        let test_code = "## Unit tests generated by " plus name plus "\n"
        test_code = test_code plus "## Source: auto-generated\n\n"
        test_code = test_code plus "bring in \"test\"\n\n"

        let lines = split code by newline
        let functions = list of
        let i = 0

        repeat while i is less than size of lines
            let line = item i of lines
            let trimmed = trim line

            if trimmed starts with "define " or trimmed starts with "behaviour "
                let parts = split trimmed by space
                let func_name = ""
                if size of parts is greater than 1
                    func_name = item 1 of parts
                    if func_name is "taking" and size of parts is greater than 2
                        func_name = item 2 of parts
                    end
                end
                if func_name is not empty and func_name is not "taking"
                    if function_name is "all" or func_name is function_name
                        add func_name to functions
                    end
                end
            end

            i = i plus 1
        end

        if size of functions is 0
            test_code = test_code plus "## No testable functions found in the provided code\n"
            test_code = test_code plus "make kind called TestSuite\n"
            test_code = test_code plus "    behaviour run\n"
            test_code = test_code plus "        show \"No tests to run\"\n"
            test_code = test_code plus "    end\n"
            test_code = test_code plus "end\n"
            give back test_code
        end

        test_code = test_code + "make kind called TestSuite\n"

        for each func in functions
            test_code = test_code + "    behaviour test " plus func + "\n"
            test_code = test_code + "        ## Test: " plus func + " handles basic cases\n"
            test_code = test_code + "        show \"Testing: " plus func + "\"\n"

            let edge_cases = analyze edge cases for func in code
            for each edge in edge_cases
                let input = edge get "input"
                let expected = edge get "expected"
                let desc = edge get "description"
                test_code = test_code + "        ## " + desc + "\n"
                test_code = test_code + "        let result = run test for " + func + " with " + input + "\n"
                test_code = test_code + "        if result is " + expected + "\n"
                test_code = test_code + "            show \"  PASS: " + desc + "\"\n"
                test_code = test_code + "        else\n"
                test_code = test_code + "            show \"  FAIL: " + desc + " (got \" plus result plus \")\"\n"
                test_code = test_code + "        end\n"
            end

            test_code = test_code + "    end\n\n"
        end

        test_code = test_code + "    behaviour run all\n"
        test_code = test_code + "        ## Execute every test in the suite\n"
        for each func in functions
            test_code = test_code + "        test " + func + "\n"
        end
        test_code = test_code + "        show \"All tests completed\"\n"
        test_code = test_code + "    end\n"

        test_code = test_code + "end\n\n"
        test_code = test_code + "let suite = new TestSuite\n"
        test_code = test_code + "suite run all\n"

        add message "system" to "Generated " plus size of functions plus " test(s)"
        give back test_code
    end

    behaviour analyze edge cases for func in code
        ## Identify boundary conditions and generate test inputs/outputs
        set status "thinking"
        let test_cases = list of
        let lines = split code by newline
        let in_func = false
        let body_lines = list of
        let i = 0

        repeat while i is less than size of lines
            let line = item i of lines
            let trimmed = trim line
            if trimmed is "define " plus func or trimmed is "behaviour " plus func
                in_func = true
            else if in_func
                if trimmed is "end"
                    in_func = false
                else
                    add trimmed to body_lines
                end
            end
            i = i plus 1
        end

        ## Analyze body for conditions, comparisons, loops
        let has_if = false
        let has_loop = false
        let has_comparison = false
        let has_arithmetic = false
        let has_list_op = false

        for each bline in body_lines
            if bline starts with "if "
                has_if = true
            end
            if bline starts with "repeat " or bline starts with "for "
                has_loop = true
            end
            if bline contains "is greater than" or bline contains "is less than" or bline contains "is not"
                has_comparison = true
            end
            if bline contains "plus" or bline contains "minus" or bline contains "times" or bline contains "divided by"
                has_arithmetic = true
            end
            if bline contains "add " or bline contains "list of" or bline contains "size of"
                has_list_op = true
            end
        end

        ## Generate appropriate test cases
        if has_if
            let tc1 = map end
            tc1 set "input" to "true"
            tc1 set "expected" to "expected_true"
            tc1 set "description" to "Branch true condition"
            add tc1 to test_cases

            let tc2 = map end
            tc2 set "input" to "false"
            tc2 set "expected" to "expected_false"
            tc2 set "description" to "Branch false condition"
            add tc2 to test_cases
        end

        if has_arithmetic
            let tc3 = map end
            tc3 set "input" to "0"
            tc3 set "expected" to "0"
            tc3 set "description" to "Zero input"
            add tc3 to test_cases

            let tc4 = map end
            tc4 set "input" to "-1"
            tc4 set "expected" to "handled"
            tc4 set "description" to "Negative input"
            add tc4 to test_cases

            let tc5 = map end
            tc5 set "input" to "1000000"
            tc5 set "expected" to "large_result"
            tc5 set "description" to "Large number input"
            add tc5 to test_cases
        end

        if has_list_op
            let tc6 = map end
            tc6 set "input" to "list of"
            tc6 set "expected" to "empty_result"
            tc6 set "description" to "Empty list"
            add tc6 to test_cases

            let tc7 = map end
            tc7 set "input" to "list of 1"
            tc7 set "expected" to "single_result"
            tc7 set "description" to "Single element list"
            add tc7 to test_cases

            let tc8 = map end
            tc8 set "input" to "list of 1 2 3 4 5"
            tc8 set "expected" to "multiple_result"
            tc8 set "description" to "Multiple element list"
            add tc8 to test_cases
        end

        if has_comparison
            let tc9 = map end
            tc9 set "input" to "equal"
            tc9 set "expected" to "boundary_result"
            tc9 set "description" to "Boundary value at threshold"
            add tc9 to test_cases
        end

        if has_loop
            let tc10 = map end
            tc10 set "input" to "0"
            tc10 set "expected" to "no_iteration"
            tc10 set "description" to "Zero iterations"
            add tc10 to test_cases

            let tc11 = map end
            tc11 set "input" to "1"
            tc11 set "expected" to "one_iteration"
            tc11 set "description" to "Single iteration"
            add tc11 to test_cases
        end

        ## If no specific patterns found, generate generic cases
        if size of test_cases is 0
            let tc = map end
            tc set "input" to "default"
            tc set "expected" to "result"
            tc set "description" to "Default test case"
            add tc to test_cases
        end

        give back test_cases
    end

    behaviour generate test data taking specification
        ## Create sample inputs and expected outputs from a spec
        set status "thinking"
        let test_data = map end
        test_data set "inputs" to list of
        test_data set "outputs" to list of

        let spec_lower = lowercase specification
        if spec_lower contains "add" or spec_lower contains "sum" or spec_lower contains "plus"
            add 0 to test_data inputs
            add 0 to test_data outputs
            add 1 to test_data inputs
            add 2 to test_data outputs
            add -5 to test_data inputs
            add 10 to test_data outputs
        else if spec_lower contains "list" or spec_lower contains "array" or spec_lower contains "collection"
            add list of to test_data inputs
            add 0 to test_data outputs
            add list of 42 to test_data inputs
            add 1 to test_data outputs
            add list of 1 2 3 4 5 to test_data inputs
            add 5 to test_data outputs
        else if spec_lower contains "string" or spec_lower contains "text"
            add "" to test_data inputs
            add "" to test_data outputs
            add "hello" to test_data inputs
            add "HELLO" to test_data outputs
        else
            add "default" to test_data inputs
            add "ok" to test_data outputs
        end

        give back test_data
    end

    behaviour check coverage
        ## Estimate test coverage percentage from function analysis
        set status "thinking"
        let total_lines = 0
        let covered_lines = 0

        let lines = split code by newline
        for each line in lines
            let trimmed = trim line
            if trimmed is not "" and not trimmed starts with "##"
                total_lines = total_lines plus 1
                ## Assume non-comment lines that are simple declarations are covered
                if trimmed starts with "make " or trimmed starts with "has " or trimmed starts with "when "
                    covered_lines = covered_lines plus 1
                else if trimmed starts with "behaviour " or trimmed starts with "end"
                    covered_lines = covered_lines plus 1
                else if trimmed starts with "let " or trimmed starts with "define "
                    covered_lines = covered_lines plus 1
                end
            end
        end

        if total_lines is 0
            give back 0
        end

        let coverage_pct = (covered_lines times 100) divided by total_lines
        give back coverage_pct
    end

    behaviour run generated tests
        ## Execute the generated test suite and report results
        set status "working"
        let test_code = generate tests for taking code and "all"

        let test_file = "./build/_generated_test.ak"
        write to file test_file and test_code

        show "Running generated tests from" test_file
        let result = run command and capture "akc run " plus test_file
        add message "system" to "Test execution completed"

        let report = map end
        report set "test_file" to test_file
        report set "result" to result
        report set "passed" to "see output"

        give back report
    end
end
